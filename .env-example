OLLAMA_PORT=11434

# The API is unauthenticated. 0.0.0.0 publishes on every interface; set this to
# a WireGuard or LAN address to confine it, or 127.0.0.1 for local-only.
#OLLAMA_BIND=0.0.0.0

# Models pulled on startup. Comma-separated; all of them are servable.
# Ollama loads a model on first request and unloads it after OLLAMA_KEEP_ALIVE.
OLLAMA_MODEL_LIST=qwen3.5:9b,llama3.2:3b,nomic-embed-text

# Used by test.http and cors-test.html for the "which model" field.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_API_URL=http://localhost:11434
# Only used by the Caddy front end in Caddyfile.example.
OLLAMA_API_KEY=for-use-with-caddy

# --- Context window -------------------------------------------------------
# Ollama defaults to 4k below 24 GiB of VRAM, 32k to 48 GiB, 256k above. Coding
# agents need at least 64k: their system prompt and tool schemas take ~15k, and
# a window that leaves little room after that makes auto-compaction thrash.
OLLAMA_CONTEXT_LENGTH=65536

# A 64k f16 KV cache does not fit beside a 9B model on 16 GB. q8_0 roughly
# halves it (flash attention is required for the quantized cache). Drop both if
# you have VRAM to spare and would rather keep an f16 cache.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# --- Optional tuning (compose.yml defaults shown) -------------------------
# Models resident in VRAM at once. One 9B model at 64k is ~10.5 GB, so 1 suits a
# 16 GB card. Ollama evicts an idle model when another is requested.
#OLLAMA_MAX_LOADED_MODELS=1
# Idle time before a loaded model is unloaded. -1 keeps it loaded forever.
#OLLAMA_KEEP_ALIVE=5m
# Each parallel slot has its own KV cache, multiplying what the context costs.
#OLLAMA_NUM_PARALLEL=1
